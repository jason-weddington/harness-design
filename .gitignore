/target
**/*.profraw

# Local, machine-specific deploy script (mirrors the Python projects).
/deploy.sh

# Local release leak scan (the maintainer links it to their scanner).
/release.guard.local.sh

# Local publish config: sets TALOS_PUBLISH_HOST for scripts/publish-talos*.sh.
/publish.local.env

# Local Claude Code session state.
/.claude/

# Maintainer-local steering (lab hosts and paths), linked in by the maintainer.
/CLAUDE.local.md

# Local direnv env (holds secrets like OLLAMA_API_KEY) — never commit.
/.envrc
/.envrc.secrets

# Harbor adapter (uv project under harbor/).
/harbor/.venv/
__pycache__/
/harbor/.coverage
/harbor/.mypy_cache/
/harbor/.ruff_cache/
/harbor/.pytest_cache/
