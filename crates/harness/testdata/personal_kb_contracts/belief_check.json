          ],
          "title": "BeliefCheckPendingCall",
          "type": "object"
        }
      },
      "description": "``POST /api/kb/belief-check``: the agent's latest text and reasoning, each truncated server-side to its last 4096 characters; session_id and turn_index are only logged.",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "reasoning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning"
        },
        "project": {
          "title": "Project",
          "type": "string"
        },
        "pending_calls": {
          "items": {
            "$ref": "#/$defs/BeliefCheckPendingCall"
          },
          "title": "Pending Calls",
          "type": "array"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "turn_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turn Index"
        }
      },
      "required": [
        "text",
        "project"
      ],
      "title": "BeliefCheckRequest",
      "type": "object"
    },
    "examples": [
      {
        "name": "talos_turn",
        "body": {
          "text": "Tests are green. Push feature branches to the mirror remote.",
          "reasoning": "The branch is ready for review, so it should go to the shared remote now.",
          "project": "personal-kb",
          "pending_calls": [
            {
